# LLM provider: groq, ollama, or openai_compatible
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Used only with LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# Used only with LLM_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Optional; the Vite dev server defaults to this value
VITE_API_URL=http://localhost:8000

# Production only: the domain Caddy uses to issue TLS certificates.
DOMAIN=rag.example.com

# Fallback for videos without YouTube captions. Runs free/local Whisper transcription.
TRANSCRIPTION_FALLBACK_ENABLED=true
# tiny, base, small, medium (base is the recommended CPU speed/accuracy balance)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
